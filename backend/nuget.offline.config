<?xml version="1.0" encoding="utf-8"?>
<!-- برای ساخت بدون دسترسی به فید داخلی: dotnet restore IKCO.ProductionFeasibility.sln با گزینه configfile و همین فایل -->
<configuration>
  <packageSources>
    <clear />
    <add key="ikco-local" value="../local-packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="ikco-local">
      <package pattern="IKCO.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>

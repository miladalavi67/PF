<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- پوشه local-packages کنار پروژه: IKCO.Auth.2.0.4.nupkg و IKCO.Infrastructure.2.0.5.nupkg (فید داخلی لازم نیست) -->
    <add key="ikco-local" value="../local-packages" />
    <add key="ikco-nuget" value="http://packages.secservice.ikco.com/repository/Nuget-Group/" allowInsecureConnections="true" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="ikco-local">
      <package pattern="IKCO.*" />
    </packageSource>
    <packageSource key="ikco-nuget">
      <package pattern="IKCO.*" />
      <package pattern="*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>

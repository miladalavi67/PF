<Project Sdk="Microsoft.NET.Sdk">

  <!-- تولید types و services فرانت‌اند React (frontend/src) از روی کنترلرهای کامپایل‌شده HttpApi با Reflection.
       اجرا از پوشه tools/ReactClientGen:  dotnet run با آرگومان مسیر پوشه frontend (برای نمونه ../../frontend)
       و گزینه configfile برابر ../../backend/nuget.offline.config. یا از ریشه frontend: npm run gen:api -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\backend\modules\ProductionFeasibility\src\IKCO.ProductionFeasibility.HttpApi\IKCO.ProductionFeasibility.HttpApi.csproj" />
  </ItemGroup>

</Project>

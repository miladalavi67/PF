# رجیستری داخلی ایران‌خودرو (Nexus). روی شبکه ایران‌خودرو registry.npmjs.org در دسترس نیست و بدون این فایل `npm i` متوقف می‌شود
# (package-lock.json آدرس بسته‌ها را روی registry.npmjs.org ثبت کرده است).
registry=http://packages.secservice.ikco.com/repository/Npm-Group/

# تمام آدرس‌های tarball داخل package-lock.json (حتی با میزبان متفاوت) روی رجیستری بالا بازنویسی می‌شود؛ lock فایل تغییر نمی‌کند.
replace-registry-host=always

# درخواست‌های audit/fund به registry.npmjs.org می‌روند و روی شبکه داخلی تا timeout معطل می‌مانند.
audit=false
fund=false

# پروکسی/Nexus داخلی کند است؛ تلاش مجدد و timeout بلندتر.
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-timeout=300000

# رجیستری روی http است (SSL داخلی گواهی عمومی ندارد).
strict-ssl=false

# خارج از شبکه ایران‌خودرو (دسترسی مستقیم به اینترنت):
#   npm ci --registry=https://registry.npmjs.org/ --replace-registry-host=npmjs
